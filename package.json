{
  "name": "@rafaeldasilvadeveloper/fast-media-tags",
  "version": "1.0.1",
  "description": "An ultra-lightweight, zero-dependency binary ID3v2 tag parser for Node/Bun/Edge, optimized for speed and memory.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafael-packages/fast-media-tags.git"
  },
  "bugs": {
    "url": "https://github.com/rafael-packages/fast-media-tags/issues"
  },
  "homepage": "https://github.com/rafael-packages/fast-media-tags#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "prepare": "bun run build",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts tests/**/*.ts"
  },
  "keywords": [
    "id3",
    "mp3",
    "audio",
    "tags",
    "metadata",
    "binary-parser",
    "typescript"
  ],
  "author": "realkalashnikov",
  "license": "MIT",
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3"
  }
}
